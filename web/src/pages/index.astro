<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quick Reference Guide</title>
  </head>
  <body>
    <header>
      <h1>Quick Reference Guide</h1>
      <div class="search">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input id="q" type="search" placeholder="Search keys, descriptions, tags…" autocomplete="off" spellcheck="false" />
        <kbd id="hint">/</kbd>
        <button id="clear" aria-label="Clear search" hidden>✕</button>
      </div>
      <nav id="tools" aria-label="Tools"></nav>
      <div class="legend" id="legend" aria-label="Mode legend" hidden></div>
    </header>
    <main id="out"></main>
    <p id="status" role="status"></p>
    <link rel="stylesheet" href="/theme.css" />
    <dialog id="dlg">
      <button id="dlg-close" aria-label="Close">✕</button>
      <div id="dlg-body"></div>
    </dialog>
  </body>
</html>

<style is:global>
  :root {
    --bg: #1e1e2e; --bg-dark: #0f0f17; --panel: #171723; --panel-hi: #353543; --line: #45475a;
    --fg: #c8e3ff; --accent: #5596ff; --accent-fill: #0061ff;
    --N: #a6e3a1; --I: #ffca55; --V: #ff9e64; --C: #25ffdb;
    --t1: #ff6f96; --t2: #a6e3a1; --t3: #ffca55; --t4: #ff9e64; --t5: #25ffdb; --t6: #cba6f7;
  }
  :root { --soft: color-mix(in srgb, var(--fg) 58%, var(--bg)); }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 0 24px 64px;
    background: var(--bg-dark); color: var(--fg);
    font: 14px/1.5 ui-monospace, "JetBrains Mono", "Fira Code", monospace;
  }
  header { padding: 32px 0 8px; text-align: center; }
  h1 { margin: 0; font-size: 28px; color: var(--fg); }
  h1 { margin-bottom: 20px; }
  .search {
    position: sticky; top: 8px; z-index: 2; display: flex; align-items: center; gap: 8px;
    max-width: 640px; margin: 0 auto; padding: 0 12px; background: var(--panel);
    border: 1px solid var(--line); border-radius: 8px; color: var(--soft);
  }
  .search:focus-within { border-color: var(--accent); }
  #q { flex: 1; padding: 11px 0; background: none; border: 0; color: var(--fg); font: inherit; outline: none; }
  kbd {
    font: inherit; font-size: 12px; padding: 0 6px; background: var(--bg); color: var(--fg);
    border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 4px;
  }
  #clear { background: none; border: 0; color: var(--soft); cursor: pointer; font: inherit; }
  #clear:hover { color: var(--fg); }
  #tools { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 16px 0 12px; }
  #tools button {
    background: var(--panel); color: var(--soft); border: 1px solid var(--line);
    padding: 4px 14px; border-radius: 999px; font: inherit; cursor: pointer;
  }
  #tools button:hover { color: var(--fg); border-color: var(--accent); }
  #tools button[aria-pressed="true"] { color: var(--fg); background: var(--accent-fill); border-color: var(--accent-fill); }
  .legend[hidden] { display: none; }
  .legend { display: flex; justify-content: center; flex-wrap: wrap; gap: 16px; color: var(--soft); font-size: 12px; }
  .legend span { display: flex; align-items: center; gap: 6px; }
  .mode { display: inline-block; min-width: 18px; text-align: center; font-size: 11px; padding: 0 5px; border-radius: 3px; color: var(--bg-dark); font-weight: 700; }
  .mode.N { background: var(--N); } .mode.I { background: var(--I); }
  .mode.V { background: var(--V); } .mode.C { background: var(--C); }

  #out { columns: max(380px, calc((var(--keys-ch, 14) + 24) * 1ch + 96px)) 4; column-gap: 16px; max-width: 1600px; margin: 24px auto 0; }
  section { break-inside: avoid; margin-bottom: 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  h2 {
    display: flex; justify-content: space-between; align-items: baseline; margin: 0; padding: 10px 14px;
    font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--t1);
    background: var(--bg); border-bottom: 1px solid var(--line);
  }
  section:nth-of-type(6n+2) h2 { color: var(--t2); }
  section:nth-of-type(6n+3) h2 { color: var(--t3); }
  section:nth-of-type(6n+4) h2 { color: var(--t4); }
  section:nth-of-type(6n+5) h2 { color: var(--t5); }
  section:nth-of-type(6n+6) h2 { color: var(--t6); }
  h2 small { text-transform: none; letter-spacing: 0; color: var(--soft); font-weight: 400; }
  .row {
    display: grid; grid-template-columns: minmax(0, calc(var(--keys-ch, 14) * 1ch)) 1fr auto; gap: 12px; align-items: baseline;
    width: 100%; padding: 7px 14px; background: none; border: 0; border-bottom: 1px solid color-mix(in srgb, var(--line) 45%, transparent);
    color: inherit; font: inherit; text-align: left; cursor: pointer;
  }
  section .row:last-child { border-bottom: 0; }
  .row:hover, .row:focus-visible { background: var(--panel-hi); outline: none; }
  .keys { color: var(--accent); word-break: break-word; }
  .desc { color: var(--fg); }
  .modes { display: flex; gap: 3px; }
  mark { background: none; color: var(--I); text-decoration: underline; }
  #status { text-align: center; color: var(--soft); margin-top: 32px; }

  dialog {
    width: min(560px, calc(100% - 32px)); padding: 20px 22px; background: var(--panel); color: var(--fg);
    border: 1px solid var(--accent); border-radius: 10px;
  }
  dialog::backdrop { background: rgb(0 0 0 / .6); }
  #dlg-close { position: absolute; top: 10px; right: 12px; background: none; border: 0; color: var(--soft); cursor: pointer; font: inherit; }
  #dlg-close:hover { color: var(--fg); }
  .d-keys { font-size: 18px; color: var(--accent); word-break: break-word; padding-right: 24px; }
  .d-meta { display: flex; gap: 6px; align-items: center; margin: 6px 0 12px; color: var(--soft); font-size: 12px; }
  .d-label { margin: 14px 0 4px; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--soft); }
  dialog pre { margin: 0; padding: 10px; background: var(--bg-dark); border: 1px solid var(--line); border-radius: 6px; white-space: pre-wrap; word-break: break-word; }
  .tags { color: var(--soft); font-size: 12px; margin-top: 12px; }
  .copy {
    margin-top: 16px; font: inherit; background: var(--accent-fill); color: var(--fg); border: 0;
    border-radius: 6px; padding: 6px 16px; cursor: pointer;
  }
  .copy:hover { filter: brightness(1.15); }
  @media (max-width: 600px) {
    .row { grid-template-columns: 1fr auto; }
    .desc { grid-column: 1 / -1; color: var(--soft); order: 3; }
  }
</style>


<script>
  type Entry = { keys: string; mode: string[]; desc: string; example?: string; tags: string[] };
  type Section = { name: string; entries: Entry[] };
  type Tool = { id: string; name: string; description?: string; sections: Section[] };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const q = $<HTMLInputElement>("q"), out = $("out"), tools = $("tools"), status = $("status");
  const clear = $("clear"), hint = $("hint"), dlg = $<HTMLDialogElement>("dlg"), dlgBody = $("dlg-body");
  const shownEntries: { tool: Tool; section: Section; entry: Entry }[] = [];

  let data: Tool[] = [];
  let active = ""; // tool id, "" = all

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const rx = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  function highlight(text: string, terms: string[]) {
    const safe = esc(text);
    if (!terms.length) return safe;
    return safe.replace(new RegExp(`(${terms.map((t) => rx(esc(t))).join("|")})`, "gi"), "<mark>$1</mark>");
  }

  function matches(tool: Tool, section: Section, e: Entry, terms: string[]) {
    const hay = [tool.name, section.name, e.keys, e.desc, e.example ?? "", ...e.tags, ...e.mode].join(" ").toLowerCase();
    return terms.every((t) => hay.includes(t));
  }

  function render() {
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    const shown = data.filter((t) => !active || t.id === active);
    // Size the key column to the guide: long commands (docker) get wider cards, short keys (nvim) stay compact.
    const lens = shown.flatMap((t) => t.sections.flatMap((s) => s.entries.map((e) => e.keys.length))).sort((a, b) => a - b);
    const pct = lens[Math.min(lens.length - 1, Math.floor(lens.length * (active ? 0.97 : 0.75)))] ?? 14;
    out.style.setProperty("--keys-ch", String(Math.max(12, Math.min(pct + 2, 40))));
    let n = 0;
    let html = "";
    shownEntries.length = 0;
    for (const tool of shown) {
      for (const sec of tool.sections) {
        const es = sec.entries.filter((e) => matches(tool, sec, e, terms));
        if (!es.length) continue;
        n += es.length;
        html += `<section><h2>${esc(sec.name)}<small>${active ? "" : esc(tool.name)}</small></h2>`;
        for (const e of es) {
          const modes = e.mode.map((m) => `<span class="mode ${m}">${m}</span>`).join("");
          html += `<button class="row" data-i="${shownEntries.length}">
            <span class="keys">${highlight(e.keys, terms)}</span>
            <span class="desc">${highlight(e.desc, terms)}</span>
            <span class="modes">${modes}</span></button>`;
          shownEntries.push({ tool, section: sec, entry: e });
        }
        html += "</section>";
      }
    }
    clear.hidden = !q.value;
    hint.hidden = !!q.value;
    out.innerHTML = html;
    status.textContent = n ? `${n} entries` : "No matches.";
  }

  const MODE_NAMES: Record<string, string> = { N: "Normal", I: "Insert", V: "Visual", C: "Command" };

  function renderLegend() {
    const used = new Set(data.filter((t) => !active || t.id === active).flatMap((t) => t.sections.flatMap((s) => s.entries.flatMap((e) => e.mode))));
    const legend = $("legend");
    legend.innerHTML = Object.keys(MODE_NAMES).filter((m) => used.has(m)).map((m) => `<span><b class="mode ${m}">${m}</b> ${MODE_NAMES[m]}</span>`).join("");
    legend.hidden = !legend.innerHTML;
  }

  function renderTools() {
    const all = [{ id: "", name: "All" }, ...data];
    tools.innerHTML = all.map((t) => `<button data-id="${t.id}" aria-pressed="${t.id === active}">${esc(t.name)}</button>`).join("");
  }

  function setActive(id: string) {
    active = data.some((t) => t.id === id) ? id : "";
    history.replaceState(null, "", active ? `#${active}` : location.pathname);
    renderTools();
    renderLegend();
    render();
  }

  tools.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement).closest("button");
    if (b) setActive(b.dataset.id!);
  });

  function openDetail(i: number) {
    const { tool, section, entry: e } = shownEntries[i];
    const modes = e.mode.map((m) => `<span class="mode ${m}">${m}</span>`).join("");
    dlgBody.innerHTML = `
      <div class="d-keys">${esc(e.keys)}</div>
      <div class="d-meta">${modes}<span>${esc(tool.name)} · ${esc(section.name)}</span></div>
      <div class="d-label">Description</div><div>${esc(e.desc)}</div>
      ${e.example ? `<div class="d-label">Example</div><pre>${esc(e.example)}</pre>` : ""}
      ${e.tags.length ? `<div class="tags">${e.tags.map((t) => "#" + esc(t)).join(" ")}</div>` : ""}
      <button class="copy">Copy</button>`;
    dlgBody.querySelector<HTMLButtonElement>(".copy")!.onclick = async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      await navigator.clipboard.writeText(e.keys);
      btn.textContent = "Copied";
      setTimeout(() => (btn.textContent = "Copy"), 1000);
    };
    dlg.showModal();
  }

  out.addEventListener("click", (ev) => {
    const row = (ev.target as HTMLElement).closest<HTMLButtonElement>(".row");
    if (row) openDetail(Number(row.dataset.i));
  });
  dlg.addEventListener("click", (ev) => {
    if (ev.target === dlg) dlg.close(); // backdrop click
  });
  $("dlg-close").addEventListener("click", () => dlg.close());
  clear.addEventListener("click", () => {
    q.value = "";
    render();
    q.focus();
  });

  q.addEventListener("input", render);
  document.addEventListener("keydown", (ev) => {
    if (ev.key === "/" && document.activeElement !== q) {
      ev.preventDefault();
      q.focus();
      q.select();
    } else if (ev.key === "Escape" && document.activeElement === q) {
      q.value ? ((q.value = ""), render()) : q.blur();
    }
  });

  try {
    data = (await (await fetch("/qrg.json")).json()).tools;
    setActive(location.hash.slice(1));
  } catch {
    status.textContent = "Could not load qrg.json — run `npm run build` at the repo root.";
  }
</script>
