[Unit]
Description=QRG quick reference guide (web)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Apps/QRG/web
# Dev server on purpose: it serves web/public/qrg.json live, so rebuilding the
# data (npm run build) shows up on reload without rebuilding the site.
ExecStart=/usr/bin/mise exec -- npx astro dev --host 127.0.0.1 --port 4321
Restart=on-failure
RestartSec=3
Environment=ASTRO_TELEMETRY_DISABLED=1

[Install]
WantedBy=default.target
